# Server-side only — do NOT prefix with NEXT_PUBLIC_. These are read by
# app/api/fleet/route.ts, which runs on the server, never in the browser.

# The Supabase edge function URL, e.g.
# https://ilujjmzpazphltsjurlq.supabase.co/functions/v1/deosdata-function
FLEET_FUNCTION_URL=https://your-project-ref.supabase.co/functions/v1/fleet-status

# The Supabase anon (or service_role) key, used only as the Bearer token
# when this server calls the edge function above.
FLEET_FUNCTION_KEY=eyJhbGciOi...
